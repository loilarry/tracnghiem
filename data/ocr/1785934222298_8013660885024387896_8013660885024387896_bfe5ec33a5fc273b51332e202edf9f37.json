[{"y":0.7546875,"x":0.7604167,"height":0.0390625,"text":"21","width":0.06666667},{"y":0.73103964,"x":0.13373676,"height":0.025546048,"text":"câu hỏi:","width":0.07106972},{"y":0.73125,"x":0.20625,"height":0.015625,"text":"Cộng san Việt Nam?","width":0.17916666},{"y":0.73061347,"x":0.2076826,"height":0.038129084,"text":"Thuật ngữ an ninh phi truyền thống được chính thức đề cập từ Đại hội mấy của Đang","width":0.6866167},{"y":0.71553963,"x":0.20622878,"height":0.014233249,"text":"Đại hội VIII","width":0.10004244},{"y":0.696875,"x":0.17708333,"height":0.0125,"text":"B)","width":0.022916667},{"y":0.696875,"x":0.20416667,"height":0.0140625,"text":"Đại hội IX","width":0.09166667},{"y":0.678125,"x":0.17708333,"height":0.0125,"text":"C)","width":0.022916667},{"y":0.6776856,"x":0.21028878,"height":0.014941263,"text":"Đại hội X","width":0.083589114},{"y":0.6578125,"x":0.20625,"height":0.0140625,"text":"Đại hội XI","width":0.08958333},{"y":0.62931657,"x":0.12072207,"height":0.0148043055,"text":"Câu hỏi:","width":0.08147253},{"y":0.63125,"x":0.20416668,"height":0.0234375,"text":"Sinh viên có trách nhiệm gì trong đấu tranh phòng, chống các mối đe đọa an ninh phi","width":0.70416665},{"y":0.61332506,"x":0.20577568,"height":0.02511678,"text":"truyền thống ở Việt Nam hiện nay?","width":0.30309397},{"y":0.6,"x":0.17916666,"height":0.0140625,"text":"A)","width":0.029166667},{"y":0.596875,"x":0.20625,"height":0.0203125,"text":"Các đổi tượng phản động người Việt tăng cường các hoạt động chống phá.","width":0.57708335},{"y":0.57388365,"x":0.2060255,"height":0.029819524,"text":"Nhận thức sâu sắc về an ninh phi truyển thống và những tác động của nó đến mọi mặt của đời","width":0.72770417},{"y":0.55908215,"x":0.20614985,"height":0.020898156,"text":"sống xã hội.","width":0.104366966},{"y":0.53125,"x":0.17916666,"height":0.0140625,"text":"C)","width":0.022916667},{"y":0.53506434,"x":0.20791255,"height":0.03485326,"text":"Các thể lực thù địch, đối tượng phản động thường lợi dụng các vấn đề tôn giáo để chồng phá","width":0.72394985},{"y":0.521875,"x":0.20833333,"height":0.015625,"text":"cách mạng Việt Nam","width":0.175},{"y":0.4990184,"x":0.17873509,"height":0.027101398,"text":"D) Việt Nam hiện đang năm trong nhóm các quốc gia thiêu nước","width":0.5196571}]