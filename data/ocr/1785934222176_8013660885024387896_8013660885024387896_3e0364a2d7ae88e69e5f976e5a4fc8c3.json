[{"text":"A) Nguôn gốc mê tính","width":0.18096848,"x":0.19059685,"height":0.041342907,"y":0.88247466},{"text":"7","width":0.035416666,"x":0.6770833,"height":0.034375,"y":0.8796875},{"text":"B Nguồn gộc nhận thức","width":0.19611485,"x":0.19025901,"height":0.042989865,"y":0.86030406},{"text":"C) Nguôn gôc xã hội","width":0.1706274,"x":0.18849711,"height":0.039500542,"y":0.84444547},{"text":"D) Nguồn gốc văn hóa","width":0.17807649,"x":0.18910958,"height":0.033202056,"y":0.8288742},{"text":"Câu hỏi: Một trong những nguồn gốc của tôn giáo?","width":0.40905726,"x":0.13460796,"height":0.058036663,"y":0.79014695},{"text":"A) Nguồn gốc tâm linh","width":0.18048689,"x":0.1880639,"height":0.029287377,"y":0.7924205},{"text":"T Nguôn gộc tâm lý","width":0.16630882,"x":0.18748039,"height":0.029621322,"y":0.7735937},{"text":"C Nguồn gộc tình cảm","width":0.18053919,"x":0.18789215,"height":0.03083088,"y":0.75360113},{"text":"D) Nguồn gốc ý thức","width":0.16537353,"x":0.18612427,"height":0.027097821,"y":0.7378578},{"text":"Câu hỏi: Một trong những tính chất của tôn giáo?","width":0.39275298,"x":0.13564835,"height":0.042345535,"y":0.7075923},{"text":"A) Tính cách mạng","width":0.14892419,"x":0.18804644,"height":0.025243342,"y":0.7022925},{"text":"B Tính lịch sử","width":0.12095588,"x":0.18660572,"height":0.020955883,"y":0.68913454},{"text":"C Tính xã hội","width":0.11659482,"x":0.18648706,"height":0.020204742,"y":0.67105603},{"text":"D) Tính nhân dân","width":0.13514043,"x":0.18663098,"height":0.019155733,"y":0.6541954},{"text":"Câu hỏi: Một trong những tính chất của tôn giáo?","width":0.3914716,"x":0.13446347,"height":0.032601245,"y":0.6257519},{"text":"A) Tính dân chủ","width":0.12519844,"x":0.18740079,"height":0.01801876,"y":0.6198969},{"text":"-, Tinh quân chúng","width":0.13856554,"x":0.2015387,"height":0.016490597,"y":0.6017552},{"text":"C) Tính tâm lý","width":0.11377594,"x":0.1868428,"height":0.01590833,"y":0.58553624},{"text":"D) Tính tình cảm","width":0.13025157,"x":0.18696147,"height":0.016226416,"y":0.5692983},{"text":"Câu hỏi: Một trong những tính chất của tôn giáo?","width":0.3863778,"x":0.13490516,"height":0.024673527,"y":0.5445401},{"text":"A) Tính nhân quyền","width":0.14791666,"x":0.1875,"height":0.015625,"y":0.534375},{"text":"*) Tính chính trị","width":0.125,"x":0.1875,"height":0.0140625,"y":0.51875},{"text":"C) Tính tín ngưỡng","width":0.14375,"x":0.1875,"height":0.0140625,"y":0.5015625},{"text":"D) Tính dân chủ","width":0.125,"x":0.18333334,"height":0.0140625,"y":0.4859375},{"text":"Câu hỏi:","width":0.07095783,"x":0.13535441,"height":0.0144194765,"y":0.460759},{"text":"Quan điểm của Chủ nghĩa Mác - Lê nin về giải quyết vấn đề tôn giáo trong cách mạng","width":0.6654452,"x":0.2100169,"height":0.029354785,"y":0.45607036},{"text":"xã hội chủ nghĩa?","width":0.13958333,"x":0.20833333,"height":0.0140625,"y":0.45},{"text":"Giải quyết vấn để tôn giáo phải găn với quá trình cài tạo xã hội cũ, xây dựng xã hội mới","width":0.6384181,"x":0.2037423,"height":0.031066315,"y":0.42054963},{"text":"B) Tôn giáo còn là một tác nhân quan trọng tạo nên những xung đột ở nhiều nơi trên thế giới","width":0.66944057,"x":0.18508846,"height":0.025654113,"y":0.40734455},{"text":"Phải kiên quyết giành độc lập dân tộc, giải phóng dân tộc đem lại tự do, hạnh phúc cho nhân","width":0.6677863,"x":0.20777193,"height":0.033013154,"y":0.38501573},{"text":"D) Tôn giáo ra đời, phát triển và tồn tại trong những điều kiện kinh tế - xã hội nhất định","width":0.6384514,"x":0.17881896,"height":0.032043573,"y":0.354128},{"text":"Câu hôi: Chính sách tôn giáo của Đảng và Nhà nước ta hiện nay?","width":0.50096977,"x":0.13282876,"height":0.026534628,"y":0.34012985},{"text":"A) Mọi tín đồ đều có quyên tự do hành đạo hợp pháp theo quy định của pháp luật","width":0.5928641,"x":0.17863385,"height":0.0335992,"y":0.31658274},{"text":"B) Xây dựng khôi đại đoàn kết dân tộc, bằng cách chia rẽ các dân tộc, các tôn giáo với nhau","width":0.67217195,"x":0.17854586,"height":0.035738975,"y":0.29724357},{"text":"C)","width":0.016666668,"x":0.17916666,"height":0.0140625,"y":0.2890625},{"text":"Tạo dựng các tổ chức phản động trong các dân tộc thiểu số, các tôn giáo để tiếp tục chống phá","width":0.689071,"x":0.20137158,"height":0.040608957,"y":0.2772326},{"text":"cách mạng Việt Nam","width":0.15208334,"x":0.2,"height":0.0171875,"y":0.2765625},{"text":"D)","width":0.020833334,"x":0.175,"height":0.0125,"y":0.25625},{"text":"Hướng dân các tôn giáo thực hiện quan hệ đồi ngoại phù hợp với đường lối đối ngoại của","width":0.6556695,"x":0.19924796,"height":0.036856167,"y":0.24171494},{"text":"Đảng và Nhà nước","width":0.13541667,"x":0.2,"height":0.015625,"y":0.24375},{"text":"Câu hỏi:","width":0.069107525,"x":0.12690458,"height":0.016534012,"y":0.21985799},{"text":"Một trong những âm mưu lợi dụng vấn đề dân tộc, tôn giáo chống phá cách mạng Việt","width":0.6830599,"x":0.1970023,"height":0.044393383,"y":0.20187359},{"text":"Nam của các thể lực thù địch?","width":0.23287874,"x":0.19522186,"height":0.025969094,"y":0.20245747},{"text":"Trực tiếp phá hoại làm suy yếu khối đại đoàn kết dân tộc bằng cách chia rẽ các dân tộc, các","width":0.6750043,"x":0.19474699,"height":0.04936298,"y":0.16304484},{"text":"tôn giáo với nhau, giữa đồng bào tôn giáo và đồng bào không tôn giáo","width":0.5188147,"x":0.19064654,"height":0.043335132,"y":0.15167564},{"text":"B)","width":0.01875,"x":0.17083333,"height":0.015625,"y":0.146875},{"text":"Đây mạnh phong trào thi đua yêu nước, xây dựng cuộc sống tốt đời, đẹp đạo trong quần","width":0.6521872,"x":0.19267458,"height":0.044124067,"y":0.12977323},{"text":"chúng, tín đồ, chức sắc, nhà tu hành ở cơ sở","width":0.32019714,"x":0.19097765,"height":0.026266769,"y":0.12753963},{"text":"C) Tăng cường thông tin tuyên truyền về chính sách tôn giáo của Đảng và Nhà nước","width":0.629015,"x":0.16568445,"height":0.043657918,"y":0.095134474},{"text":"Các tôn giáo thực hiện quan hệ đối ngoại phù hợp với đường lối đổi ngoại của Đảng và Nhà","width":0.6879066,"x":0.19037196,"height":0.050310746,"y":0.07030839}]